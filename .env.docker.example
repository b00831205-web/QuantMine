# Docker Compose variable reference. Prefer generating a private .env.docker:
#   python scripts/create_docker_env.py
#   docker compose --env-file .env.docker up -d --build
#
# If you copy this file by hand, replace every REPLACE_ME. Placeholder values
# are rejected at container startup and must never be deployed.

# -- Postgres superuser (used inside the container only) --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME

# -- Application role passwords (webapi / pipeline / airflow database logins) --
QUANTMINE_WEB_PASSWORD=REPLACE_ME
QUANTMINE_PIPELINE_PASSWORD=REPLACE_ME
AIRFLOW_DB_PASSWORD=REPLACE_ME

# -- Session signing secret: generate a random value --
#   python -c "import secrets;print(secrets.token_hex(32))"
QUANT_AUTH_SECRET=REPLACE_ME

# -- Initial application administrator (created idempotently when webapi starts) --
QUANTMINE_ADMIN_USER=admin
QUANTMINE_ADMIN_PASSWORD=REPLACE_ME

# -- Airflow 3.x encryption key: generate with --
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=REPLACE_ME

# -- AI provider API keys --
# Every variable in this file is forwarded into the webapi container, so adding a
# provider is a one-line change here -- docker-compose.yml never needs editing.
# The variable name is free-form: it only has to match the "API Key env var"
# field of that provider in the AI Config page.
#
# Recreate webapi after editing; a running container keeps its environment:
#   docker compose --env-file .env.docker up -d webapi
#OPENAI_API_KEY=
#SILICONFLOW_API_KEY=
#DEEPSEEK_API_KEY=
#MOONSHOT_API_KEY=
#DASHSCOPE_API_KEY=
#ZHIPU_API_KEY=
#OPENROUTER_API_KEY=

# -- Upstream proxy for mainland-China access to Yahoo/Wikipedia (yfinance) --
# yfinance fetches Yahoo data; without a proxy it fails on mainland networks.
# Inside the container use host.docker.internal to reach the proxy running on
# the Windows host (127.0.0.1 would be the container itself). Leave these
# commented out / empty to connect directly.
#http_proxy=http://host.docker.internal:7897
#https_proxy=http://host.docker.internal:7897
#no_proxy=localhost,127.0.0.1,::1,postgres,webapi
