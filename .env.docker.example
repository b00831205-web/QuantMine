# Docker Compose variable reference. Prefer generating a private .env.docker:
#   python scripts/create_docker_env.py
#   docker compose --env-file .env.docker up -d --build
#
# If you copy this file by hand, replace every REPLACE_ME. Placeholder values
# are rejected at container startup and must never be deployed.

# -- Postgres superuser (used inside the container only) --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME

# -- Application role passwords (webapi / pipeline / airflow database logins) --
QUANTMINE_WEB_PASSWORD=REPLACE_ME
QUANTMINE_PIPELINE_PASSWORD=REPLACE_ME
AIRFLOW_DB_PASSWORD=REPLACE_ME

# -- Session signing secret: generate a random value --
#   python -c "import secrets;print(secrets.token_hex(32))"
QUANT_AUTH_SECRET=REPLACE_ME

# -- Initial application administrator (created idempotently when webapi starts) --
QUANTMINE_ADMIN_USER=admin
QUANTMINE_ADMIN_PASSWORD=REPLACE_ME

# -- Airflow 3.x encryption key: generate with --
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=REPLACE_ME
